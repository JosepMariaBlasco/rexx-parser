  result = FencedCode("test.md", .resources~NumberLines)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~caselessPos('class="rx-numbered') > 0, -
    "Line numbers: .numberLines produces rx-numbered class on pre")

