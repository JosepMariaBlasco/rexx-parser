::Method test_mode_expression_peels_parens
  -- `a = b`{.rexx expression}: wrap in (), parse, peel the synthetic parens.
  -- The result must contain a/=/b as tokens and NOT the "(" or ")" spans.
  result = FencedCode("test.md", .resources~ModeExpression)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('<span class="rx-var">a</span>') > 0, -
    "expression: 'a' is coloured as a variable")
  self~assertTrue(flat~pos('<span class="rx-op">=</span>') > 0, -
    "expression: '=' is coloured as an operator (comparison, not assignment)")
  self~assertTrue(flat~pos('<span class="rx-var">b</span>') > 0, -
    "expression: 'b' is coloured as a variable")
  self~assertTrue(flat~pos('>(<') == 0, -
    "expression: the synthetic opening parenthesis is peeled off")
  self~assertTrue(flat~pos('>)<') == 0, -
    "expression: the synthetic closing parenthesis is peeled off")

::Method test_mode_expression_illformed_shouts
  -- An expression that does not hold even inside () shouts (passed through).
  result = FencedCode("test.md", .resources~ModeExpressionBad)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('rx-fragment-error') > 0, -
    "expression ill-formed: produces an error chip")

::Method test_hyphen_form_gone
  -- The hyphen form is retired (hard cut): {.rexx-method} is no longer a
  -- recognised class, so the mention is left verbatim, dot and all.
  result = FencedCode("test.md", .resources~HyphenFormGone)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('`Bark`{.rexx-method}') > 0, -
    "Hard cut: {.rexx-method} is left verbatim (no longer recognised)")
  self~assertTrue(flat~caselessPos('rx-const rx-method') == 0, -
    "Hard cut: {.rexx-method} produces no method colouring")

::Method test_glyph_name_gone
  -- A former glyph name is retired: {.rexx plus} is neither a mode nor a
  -- ProseTable name, so "plus" is not a modifier -- it is treated as a
  -- fence-style option (which ParseOptions ignores). The glyph itself still
  -- colours by lookup, so `+`{.rexx plus} colours the "+" as an operator and
  -- the dead name simply does nothing. (The NAME is gone; the glyph is the API.)
  result = FencedCode("test.md", .resources~GlyphNameGone)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('<code class="rexx rx-op">+</code>') > 0, -
    "Hard cut: 'plus' is dead; the glyph still colours by lookup as rx-op")

/******************************************************************************/
/* program= : sibling fences fused into one logical listing                   */
/*                                                                            */
/* Fences sharing a program= name are one program. ProcessPrograms gathers     */
/* the fragments, highlights the listing whole in ONE stateful pass, and cuts  */
/* the emitted block back into one block per fragment (CutProgramBlocks); the  */
/* slices are then dealt back into their fences' places                        */
/* (PlaceProgramBlocks). Grouping is by a NORMALISED key (blank/dash runs ->   */
/* single dash, uppercased -- ProgramKey), while the author's as-is name is    */
/* preserved for a future auto-caption. These tests are the dedicated          */
/* coverage the feature lacked: v169/v170 taught that without one, a broken    */
/* seam passes as green. The discriminating signature of a REAL fusion is a    */
/* clause that spans the seam (a trailing-comma continuation resolved in a     */
/* single pass) -- cosmetic-only "fusion" cannot do that.                      */
/*                                                                            */
/* The cut is COLD: nothing is reopened mid-emission, so the numbering and     */
/* line-span tests below are checking a property of the design, not of a       */
/* clean-up pass over a damaged emission.                                      */
/******************************************************************************/

::Method countOf Private
  -- How many times `needle` appears in `hay` (caseless). Test helper.
  Use Strict Arg needle, hay
  n = 0; p = 1
  Loop Forever
    q = hay~caselessPos(needle, p)
    If q == 0 Then Leave
    n += 1; p = q + 1
  End
  Return n

::Method test_program_two_fragments_make_two_blocks
  -- Two sibling fences with the same name fuse and are dealt back out as two
  -- wrapper blocks in their original spots; no placeholder leaks to the output.
  result = FencedCode("test.md", .resources~ProgramTwo)
  flat   = result~makeString('L', "0A"x)
  self~assertEquals(2, self~countOf("rx-blockwrap", flat), -
    "program: two same-named fences produce two wrapper blocks")
  self~assertEquals(0, flat~caselessPos("<!--rxprogram"), -
    "program: no raw <!--rxprogram:...--> placeholder survives to output")

::Method test_program_internal_marker_never_leaks
  -- The internal seam char ('1e'x) is a private device: it must never appear
  -- in the emitted HTML.
  result = FencedCode("test.md", .resources~ProgramTwo)
  flat   = result~makeString('L', "0A"x)
  self~assertEquals(0, flat~pos("1e"x), -
    "program: internal '1e'x seam marker does not leak into the output")

::Method test_program_stateful_across_seam
  -- The prize test. Fragment 1 ends with a trailing-comma continuation
  -- ("x = 1 + ,") and fragment 2 supplies the rest ("2"). Only a genuine
  -- fusion parses "x = 1 + 2" as ONE assignment in a single stateful pass:
  -- exactly one rx-asg and one rx-cont, with both integers coloured (one on
  -- each side of the seam). A non-fused pass would leave a dangling
  -- continuation in fragment 1 (a syntax error), so seeing the clean signature
  -- proves the seam is real.
  result = FencedCode("test.md", .resources~ProgramSeam)
  flat   = result~makeString('L', "0A"x)
  self~assertEquals(1, self~countOf('class="rx-asg"', flat), -
    "program seam: the continued clause is one assignment across the seam")
  self~assertEquals(1, self~countOf('class="rx-cont"', flat), -
    "program seam: the trailing-comma continuation is recognised")
  self~assertEquals(2, self~countOf('rx-int', flat), -
    "program seam: both integers colour, one on each side of the seam")

::Method emptyLineSpans Private
  -- Count empty line spans in `flat`: "<span id="rxN-M"><a ...></a></span>"
  -- with nothing between the </a> and the </span>. These are the seam ghosts
  -- a reopened block used to strand at its head. Test helper.
  Use Strict Arg flat
  n = 0; p = 1
  Loop Forever
    q = flat~caselessPos('<span id="rx', p)
    If q == 0 Then Leave
    aClose = flat~pos('</a>', q)
    sClose = flat~pos('</span>', q)
    If aClose > 0, sClose > 0, sClose == aClose + 4 Then n += 1
    p = q + 1
  End
  Return n

::Method test_program_no_empty_line_spans_at_seam
  -- Regression guard for the reopened-block artefact: when a program is split
  -- across a seam, the reopened block must NOT begin with empty, mis-numbered
  -- line spans (the -3/-4/-5 ghosts). The five-line first fragment is what made
  -- the old bug emit three ghosts. Every emitted line span must carry code, so
  -- the empty-line-span count is zero; and numbering must continue across the
  -- seam -- the reopened block's first line is -6, and no line reuses a
  -- first-fragment number (-3). The block-id prefix (rxN) is assigned at run
  -- time from a running counter, so we match on the line-number suffix only.
  result = FencedCode("test.md", .resources~ProgramMultiline)
  flat   = result~makeString('L', "0A"x)
  self~assertEquals(0, self~emptyLineSpans(flat), -
    "program seam: no empty line spans stranded at the head of the reopened block")
  self~assertTrue(flat~pos('-6"><a href="#') > 0, -
    "program seam: the reopened block's first line continues numbering at 6")

::Method lineNumbersOf Private
  -- The line-number suffix of every line span in `flat`, in emission order.
  -- Test helper: the block-id prefix is assigned at run time, so only the
  -- suffix is meaningful here.
  Use Strict Arg flat
  nums = .Array~new
  p = 1
  Loop Forever
    q = flat~caselessPos('<span id="rx', p)
    If q == 0 Then Leave
    Parse Value SubStr(flat, q) With '<span id="rx'.'-'num'"'
    nums~append( num )
    p = q + 1
  End
  Return nums

::Method test_program_numbering_is_contiguous_across_seam
  -- The seam must not disturb the numbering ANYWHERE in the reopened block,
  -- not merely at its first line. The old hot-cut design reopened the block
  -- mid-emission and mis-carried the number of any line whose clause was still
  -- in flight across the cut -- the second line of a block comment came out
  -- numbered from the wrong origin while its neighbours were right, so a test
  -- that only checked the first line passed while the block was visibly wrong.
  -- The cold cut cannot do that: the listing is emitted whole and sliced after
  -- the fact, so the numbers are simply 1..N, in order, no gaps, no repeats.
  result = FencedCode("test.md", .resources~ProgramNumbering)
  flat   = result~makeString('L', "0A"x)
  nums   = self~lineNumbersOf(flat)
  self~assertEquals(10, nums~items, -
    "program numbering: one line span per source line, ten in all")
  expected = .Array~new
  Do i = 1 To 10
    expected~append( i )
  End
  self~assertEquals(expected~makeString('L', ","), nums~makeString('L', ","), -
    "program numbering: contiguous 1..10 across the seam, gaps and repeats both")

::Method test_program_slices_carry_their_own_counter_origin
  -- Continuous numbering used to be a side effect of reopening the block. Each
  -- slice now states its own origin instead: the second slice starts at source
  -- line 6, so its <code> resets the counter to 5. The first slice starts at 1
  -- and needs no reset, exactly as an ordinary block does.
  result = FencedCode("test.md", .resources~ProgramNumbering)
  flat   = result~makeString('L', "0A"x)
  self~assertEquals(1, self~countOf('counter-reset: rx-line 5;', flat), -
    "program slices: the second slice resets the line counter to 5")
  self~assertEquals(2, self~countOf('rx-blockwrap', flat), -
    "program slices: two blocks, one per fragment")

::Method test_program_blocks_have_distinct_ids
  -- One emitted block carries one id; cutting it into N means N wrappers, and
  -- a document may not repeat an id. Each slice gets its own, and its line
  -- spans are rebranded to match, so "id of line = id of block, dash, number"
  -- holds for every slice.
  result = FencedCode("test.md", .resources~ProgramNumbering)
  flat   = result~makeString('L', "0A"x)
  -- The wrapper's id and its "rx-blockwrap" class sit on the same tag, in
  -- whichever order; take the id from the <div ...> line that carries the class.
  ids = .Array~new
  Do line Over result
    If \line~caselessContains('rx-blockwrap') Then Iterate
    Parse Value line With 'id="'id'"'
    ids~append( id )
  End
  self~assertEquals(2, ids~items, "program ids: two wrappers")
  self~assertTrue(ids[1] \== ids[2], -
    "program ids: the two wrappers do not share an id")
  self~assertTrue(flat~pos('id="'ids[2]'-6"') > 0, -
    "program ids: the second block's first line hangs off the second block's id")

::Method test_program_key_normalises_case
  -- Grouping key is uppercased: "demo" and "DEMO" are the same program.
  -- If they did not fuse there would be two independent listings; we prove
  -- fusion via the cross-seam continuation signature.
  result = FencedCode("test.md", .resources~ProgramCase)
  flat   = result~makeString('L', "0A"x)
  self~assertEquals(1, self~countOf('class="rx-cont"', flat), -
    "program key: differing case ('demo'/'DEMO') fuses into one program")

::Method test_program_key_normalises_blanks_and_dashes
  -- A quoted, blank-bearing name and its dashed form normalise to the same
  -- key: "The Towers of Hanoi" == "the-towers-of-hanoi". They fuse.
  result = FencedCode("test.md", .resources~ProgramBlanksDashes)
  flat   = result~makeString('L', "0A"x)
  self~assertEquals(1, self~countOf('class="rx-cont"', flat), -
    "program key: quoted-with-blanks and dashed forms fuse (same key)")

::Method test_program_quoted_name_with_blanks
  -- A quoted value carrying blanks is accepted as the name (it does not end at
  -- the first blank). Two quoted siblings with the same name fuse.
  result = FencedCode("test.md", .resources~ProgramQuoted)
  flat   = result~makeString('L', "0A"x)
  self~assertEquals(2, self~countOf("rx-blockwrap", flat), -
    "program quoted: a blank-bearing quoted name fuses its two fragments")
  self~assertEquals(0, flat~caselessPos("<!--rxprogram"), -
    "program quoted: no placeholder leaks")

::Method test_program_distinct_names_do_not_fuse
  -- Two DIFFERENT names are two independent programs. Each is valid on its
  -- own; nothing fuses, so there is no cross-seam continuation. Both blocks
  -- still render, and no placeholder leaks.
  result = FencedCode("test.md", .resources~ProgramDistinct)
  flat   = result~makeString('L', "0A"x)
  self~assertEquals(2, self~countOf("rx-blockwrap", flat), -
    "program distinct: two different names give two independent blocks")
  self~assertEquals(0, self~countOf('class="rx-cont"', flat), -
    "program distinct: no fusion, so no cross-seam continuation")
  self~assertEquals(0, flat~caselessPos("<!--rxprogram"), -
    "program distinct: no placeholder leaks")

::Method test_program_absent_is_noop
  -- With no program= anywhere, the fusion machinery is a no-op: an ordinary
  -- single fence highlights exactly as it always did.
  result = FencedCode("test.md", .resources~ProgramNone)
  flat   = result~makeString('L', "0A"x)
  self~assertEquals(1, self~countOf("rx-blockwrap", flat), -
    "program absent: a lone fence still produces one block")
  self~assertEquals(0, flat~caselessPos("<!--rxprogram"), -
    "program absent: no fusion placeholder appears")
  self~assertTrue(flat~caselessPos("highlight-rexx-dark") > 0, -
    "program absent: ordinary highlighting is unaffected")

--------------------------------------------------------------------------------
-- A (v176): multi-word modifier grammar -- longest-match 3 -> 2 -> 1, one
-- unified vocabulary (ProseModifierTable). The hyphens are gone: a modifier that
-- used to be a hyphenated atom is now composition.
--------------------------------------------------------------------------------

-- The one 3-word modifier: "external package function". Longest-match must take
-- all three words, not stop at "external" or "external package".
::Method test_prose_modifier_three_words
  result = FencedCode("test.md", .resources~ProseExtPkgFunc)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('<code class="rexx rx-const rx-ext-pkg-func">MyRoutine</code>') > 0, -
    "Multi-word modifier: `external package function` (3 words) resolves to rx-ext-pkg-func")

-- A 2-word modifier followed by a real attribute: the longest match consumes
-- exactly the two vocabulary words, and `style=light` is left as an attribute
-- (the mention is styled light, not dark). This is the guard that the
-- longest-match never mistakes an attribute for a modifier tail.
::Method test_prose_modifier_two_words_then_attr
  result = FencedCode("test.md", .resources~ProseBifFuncStyled)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('<code class="rexx rx-const rx-bif-func">Length</code>') > 0, -
    "Multi-word modifier: `builtin function` (2 words) resolves to rx-bif-func")
  self~assertTrue(flat~pos("highlight-rexx-light") > 0, -
    "Multi-word modifier: the trailing style=light attribute is honoured, not eaten")

-- The 2-word "external package" shortcut (subroutine sense) must NOT be stolen
-- by the 1-word "external": longest-match fires the 2-word entry.
::Method test_prose_modifier_two_word_shortcut
  result = FencedCode("test.md", .resources~ProseExtPkgShortcut)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('<code class="rexx rx-const rx-ext-pkg-proc">Thing</code>') > 0, -
    "Multi-word modifier: `external package` (2 words) resolves to the subroutine class")

-- blank concatenation is an OPERATOR now (not a parse mode): a named operator
-- whose glyph is a space. It colours as rx-op, and its glyph (a single space) is
-- preserved as the span content -- SymbolChip would have stripped it away.
::Method test_prose_blank_concatenation_operator
  result = FencedCode("test.md", .resources~ProseBlankConcat)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('<code class="rexx rx-op"> </code>') > 0, -
    "Named operator: `blank concatenation` colours as rx-op with its space glyph preserved")

-- A modifier that is NOT in the vocabulary is not a modifier at all: the whole
-- rest is attributes, so the span auto-parses. Here the content is a bare name,
-- so it colours as a variable -- proof the unknown word did not become a modifier
-- and did not shout.
::Method test_prose_unknown_modifier_falls_through
  result = FencedCode("test.md", .resources~ProseUnknownModifier)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('<span class="rx-var">Foo</span>') > 0, -
    "Unknown modifier: a non-vocabulary word is not a modifier; the span auto-parses")

