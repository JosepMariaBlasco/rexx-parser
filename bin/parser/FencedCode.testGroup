::Method test_prose_method_string_matches_fenced
  -- The core spans of the mention are byte-for-byte a fenced `::Method "Bark"`'s
  -- name spans. We assert each of the three constant spans appears from the
  -- mention AND from the fence below it.
  result = FencedCode("test.md", .resources~ProseMethodStringMatchesFenced)
  flat   = result~makeString('L', "0A"x)
  Do span Over .Array~of( -
      '<span class="rx-const rx-method rx-oquo">"</span>', -
      '<span class="rx-const rx-method">Bark</span>', -
      '<span class="rx-const rx-method rx-cquo">"</span>' )
    count = 0
    pos   = 1
    Loop Forever
      pos = flat~pos(span, pos)
      If pos == 0 Then Leave
      count += 1
      pos += 1
    End
    self~assertEquals(2, count, -
      "Method string matches fenced: each name span appears in both mention and fence")
  End

::Method test_prose_method_tag_overrides_engine_guess
