  self~expectSyntax(88.900)
  result = FencedCode("test.md", .resources~BadOption)

/******************************************************************************/
/* --continue: error in Rexx code does not abort                              */
/******************************************************************************/

::Method test_continue_error_box
  defaultOptions.         = 0
  defaultOptions.continue = 1
  result = FencedCode("test.md", .resources~BadRexx, "dark", defaultOptions.)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~caselessPos("background-color: red") > 0, -
    "Continue: parse error produces red error box")

::Method test_continue_error_info
  defaultOptions.         = 0
  defaultOptions.continue = 1
  result = FencedCode("test.md", .resources~BadRexx, "dark", defaultOptions.)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos("Error") > 0, -
    "Continue: error box contains error information")

/******************************************************************************/
/* Empty code block                                                           */
/******************************************************************************/

::Method test_empty_block
  result = FencedCode("test.md", .resources~EmptyBlock)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~caselessPos('highlight-rexx-dark') > 0, -
    "Empty block: produces highlight div even when empty")

/******************************************************************************/
/* Indented fenced blocks (issue #2)                                          */
/*                                                                            */
/* A ```rexx fence that lives inside a list item is indented. FencedCode must */
/* (a) recognise the marker after the indent, (b) de-indent the code so the   */
/* parser sees real column 1, and (c) re-indent the highlighted HTML by the   */
/* same amount so Pandoc still reads the block as content of the list item.   */
/* The un-indented (column-1) path must stay byte-identical.                  */
/******************************************************************************/

::Method test_indented_is_highlighted
  result = FencedCode("test.md", .resources~Indented)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~caselessPos('highlight-rexx-dark') > 0, -
    "Indented: an indented rexx block is highlighted")

::Method test_indented_keyword_highlight
  result = FencedCode("test.md", .resources~Indented)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~caselessPos('class="rx-kw"') > 0, -
    "Indented: Say inside an indented block is highlighted as keyword")

::Method test_indented_no_fence_markers
  result = FencedCode("test.md", .resources~Indented)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('```') == 0, -
    "Indented: the indented fence markers are consumed, not left in output")

::Method test_indented_html_is_reindented
  -- The highlighted block must keep its two-space indent so Pandoc attaches it
  -- to the enclosing list item. We look for a line that both is indented and
  -- carries the highlight wrapper.
  result = FencedCode("test.md", .resources~Indented)
  reindented = 0
  Loop line Over result
    If line~startsWith("  "), line~caselessPos('highlight-rexx') > 0 Then reindented = 1
  End
  self~assertTrue(reindented, -
    "Indented: highlighted HTML is re-indented under the list item")

::Method test_indented_preserves_following_text
  -- The closing marker is itself indented; if it were not recognised, the
  -- trailing bullet would be swallowed into the block.
  result = FencedCode("test.md", .resources~Indented)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos("After the block") > 0, -
    "Indented: text after an indented block is preserved (close is recognised)")

::Method test_indented_code_deindented
  -- The keyword token must be exactly 'Say' with no list indent leaked into it.
  result = FencedCode("test.md", .resources~Indented)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('>Say<') > 0, -
    "Indented: the keyword token is exactly 'Say', no indent leaked in")

::Method test_deep_indent
  -- Six spaces: the real depth-3 case from the 142 deck (fences under CLI cmd).
  result = FencedCode("test.md", .resources~DeepIndent)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~caselessPos('highlight-rexx-dark') > 0, -
    "Deep indent: a 6-space-indented block is highlighted")

::Method test_indented_twiddles
  result = FencedCode("test.md", .resources~IndentedTwiddles)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~caselessPos('highlight-rexx-dark') > 0, -
    "Indented twiddles: an indented ~~~ block is highlighted")

::Method test_indented_close_with_tab
  -- The closing marker sits after a tab; it must still be recognised so the
  -- following text is not swallowed.
  result = FencedCode("test.md", .resources~TabClose)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos("Tail text") > 0, -
    "Tab close: a tab-indented closing marker is recognised")

::Method test_column1_unchanged_by_indent_logic
  -- Guardrail: the classic column-1 block still highlights, and its wrapper
  -- div carries no leading indent (the indent branch left it alone).
  result = FencedCode("test.md", .resources~Basic)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~caselessPos('highlight-rexx-dark') > 0, -
    "Column 1: an un-indented block is unaffected by the indent logic")
  self~assertTrue(flat~pos("  <div") == 0, -
    "Column 1: an un-indented block produces no leading indent on its div")

/******************************************************************************/
/* Prose mentions: `x`{.rexx-*} outside fences                                */
/*                                                                            */
/* ScanProseMentions (private to FencedCode.cls) is exercised only through   */
/* the public FencedCode() entry point, like every other test in this file.  */
/* HTMLClasses.cls's own facade (ProseTable/ProseElementTags) and the HTML   */
/* driver's ProseMention are unit-covered indirectly this way: what matters  */
/* is the shape FencedCode() actually emits into a document.                 */
/******************************************************************************/

::Method test_prose_method_mention
  result = FencedCode("test.md", .resources~ProseMethod)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('<code class="rexx rx-const rx-method">Bark</code>') > 0, -
    "Prose mention: rexx-method resolves to 'rx-const rx-method'")

::Method test_prose_mention_wrapper
  result = FencedCode("test.md", .resources~ProseMethod)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('<span class="highlight-rexx-dark"><code') > 0, -
    "Prose mention: wrapped in its own highlight-rexx-<style> micro-container")

::Method test_prose_var_mention
  result = FencedCode("test.md", .resources~ProseVar)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('<code class="rexx rx-var">foo</code>') > 0, -
    "Prose mention: rexx-variable resolves to 'rx-var'")

::Method test_prose_directive_mention
  -- The COMPOUND `directive`: `::Method` is `::` + keyword, so it renders as a
  -- single chip holding two token spans (rx-dir then rx-dkw), NOT one monolith.
  result = FencedCode("test.md", .resources~ProseDirective)
  flat   = result~makeString('L', "0A"x)
  expected = '<code class="rexx"><span class="rx-dir">::</span>' -
          || '<span class="rx-dkw">METHOD</span></code>'
  self~assertTrue(flat~pos(expected) > 0, -
    "Prose mention: rexx directive (compound) resolves to rx-dir + rx-dkw")

-- (The old test_prose_directive_start_mention -- `::`{.rexx directive-start} by
-- NAME -- is gone with A: "directive start" is no longer vocabulary. A lone `::`
-- colours as rx-dir by GLYPH lookup, covered by test_prose_bare_directive_start_glyph.)

::Method test_prose_directive_keyword_mention
  result = FencedCode("test.md", .resources~ProseDirectiveKeyword)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('<code class="rexx rx-dkw">Method</code>') > 0, -
    "Prose mention: rexx directive keyword resolves to 'rx-dkw'")

-- Section 3a coverage: a taken-constant name (requires) and an exposed
-- variable (which maps by element, not through the constant axis).
::Method test_prose_requires_mention
  result = FencedCode("test.md", .resources~ProseRequires)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('<code class="rexx rx-const rx-requires">utils.rex</code>') > 0, -
    "Prose mention: rexx-requires resolves to 'rx-const rx-requires'")

::Method test_prose_exposed_variable_mention
  -- exposed on a simple variable: auto-parse (rx-var), relabel the base to xvar.
  result = FencedCode("test.md", .resources~ProseExposedVariable)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('<span class="rx-xvar">total</span>') > 0, -
    "exposed (simple): the base is relabelled to rx-xvar")

-- Section 3b coverage: an explicit function form and a bare shortcut (which
-- must resolve to the SUBROUTINE subcategory, the engine's term for procedure).
::Method test_prose_builtin_function_mention
  result = FencedCode("test.md", .resources~ProseBuiltinFunction)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('<code class="rexx rx-const rx-bif-func">Length</code>') > 0, -
    "Prose mention: rexx builtin function resolves to 'rx-const rx-bif-func'")

::Method test_prose_internal_shortcut_mention
  result = FencedCode("test.md", .resources~ProseInternalShortcut)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('<code class="rexx rx-const rx-int-proc">Helper</code>') > 0, -
    "Prose mention: rexx internal (shortcut) resolves to the subroutine class")

-- A {.rexx} fragment that does not parse "shouts": the red chip AND the
-- parser's own complaint appended (generic error text + specific message),
-- so the author sees exactly what the parser choked on.
::Method test_prose_fragment_error_shows_message
  result = FencedCode("test.md", .resources~ProseBadFragment)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('rx-fragment-error') > 0, -
    "Bad fragment: the offending code is shown in the red error chip")
  self~assertTrue(flat~pos('rx-fragment-error-msg') > 0, -
    "Bad fragment: the parser's complaint is appended in its own span")
  self~assertTrue(flat~pos('after ::METHOD keyword') > 0, -
    "Bad fragment: the specific, contextualised message is included")

-- INVERTED CASCADE: a bare {.rexx} classifies by lookup BEFORE it pays for a
-- parse. A lone clause keyword (do/if/end/select/when/then/else/otherwise) does
-- NOT parse on its own, but it IS a keyword -- so the lookup colours it rx-kw
-- instead of letting the parser shout "Incomplete DO".
::Method test_prose_bare_clause_keyword_colours_as_keyword
  result = FencedCode("test.md", .resources~ProseBareClauseKeywords)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('<code class="rexx rx-kw">Do</code>') > 0, -
    "Bare `Do`{.rexx}: a lone clause keyword colours as rx-kw, no parse shout")
  self~assertTrue(flat~pos('<code class="rexx rx-kw">If</code>') > 0, -
    "Bare `If`{.rexx}: a lone clause keyword colours as rx-kw, no parse shout")
  self~assertTrue(flat~pos('<code class="rexx rx-kw">End</code>') > 0, -
    "Bare `End`{.rexx}: a lone clause keyword colours as rx-kw, no parse shout")
  self~assertTrue(flat~pos('rx-fragment-error') == 0, -
    "Bare clause keywords: none of them produces a red error chip")

-- The bare lookup fires only on an EXACT single keyword: a fragment that merely
-- BEGINS with a keyword (`Say "hi"`) still falls through to the parser, which
-- tokenises the whole thing (keyword + the rest), not one flat rx-kw.
::Method test_prose_keyword_leading_fragment_still_parses
  result = FencedCode("test.md", .resources~ProseKeywordLeading)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('<span class="rx-kw">Say</span>') > 0, -
    "Leading keyword: `Say ""hi""`{.rexx} is parsed (kw span), not looked up flat")
  self~assertTrue(flat~pos('rx-str') > 0, -
    "Leading keyword: the rest of the fragment is tokenised too")

-- A bare `::keyword` WITHOUT a name no longer shouts: the `::` and the keyword
-- are recognised by lookup and emitted as the two-span dir+dkw chip.
::Method test_prose_bare_compound_directive_no_name
  result = FencedCode("test.md", .resources~ProseBareDirectiveNoName)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('<span class="rx-dir">::</span><span class="rx-dkw">Method</span>') > 0, -
    "Bare `::Method`{.rexx}: recognised as dir+dkw by lookup, no modifier needed")
  self~assertTrue(flat~pos('rx-fragment-error') == 0, -
    "Bare `::Method`{.rexx}: no red error chip")

-- The compound-directive lookup fires only WITHOUT a name: `::Class Bar` (with
-- a name) is a complete directive that parses, so it falls through to the parser
-- and its name is coloured -- the lookup must NOT steal it.
::Method test_prose_directive_with_name_still_parses
  result = FencedCode("test.md", .resources~ProseDirectiveWithName)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('<span class="rx-const rx-class">Bar</span>') > 0, -
    "Directive with name: `::Class Bar`{.rexx} parses and colours the class name")

-- A lone `::` is a plain glyph now (directive start), resolved by the symbol
-- table -- no modifier, no shout.
::Method test_prose_bare_directive_start_glyph
  result = FencedCode("test.md", .resources~ProseBareDirectiveStart)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('<code class="rexx rx-dir">::</code>') > 0, -
    "Bare `::`{.rexx}: the directive-start glyph colours as rx-dir by lookup")

-- exposed on a stem / compound: auto-parse then relabel the base to the
-- exposed class. Only the base -- tails stay as the auto-parse coloured them
-- (a documented limitation, since a bare fragment has no Expose context).
::Method test_prose_exposed_stem_mention
  result = FencedCode("test.md", .resources~ProseExposedStem)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('<code class="rexx"><span class="rx-xstem">data.</span></code>') > 0, -
    "exposed (stem): the base is relabelled to rx-xstem")

::Method test_prose_exposed_compound_mention
  result = FencedCode("test.md", .resources~ProseExposedCompound)
  flat   = result~makeString('L', "0A"x)
  -- Base relabelled to rx-xstem; the tail stays a normal rx-var (limitation).
  self~assertTrue(flat~pos('<span class="rx-xstem">order.</span><span class="rx-var">item</span>') > 0, -
    "exposed (compound): base becomes rx-xstem, tail stays rx-var")

::Method test_prose_exposed_not_a_variable_errors
  -- SAFETY: the one modifier deduces the kind from the parse, but the fragment
  -- must BE a variable. A fragment that is not (an expression, an instruction)
  -- is off-domain: we do not force anything -- we shout with our own error chip.
  result = FencedCode("test.md", .resources~ProseExposedNotVar)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('rx-fragment-error') > 0, -
    "exposed on a non-variable fragment produces an honest error chip")
  self~assertTrue(flat~pos('Not a variable') > 0, -
    "exposed off-domain: the message names the domain")

::Method test_prose_around_fence_before
  -- Prose BEFORE a fence goes through source~section(1, start-1): the
  -- other copy point from the one after the last fence.
  result = FencedCode("test.md", .resources~ProseAroundFence)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('<code class="rexx rx-const rx-method">Bark</code>') > 0, -
    "Prose around fence: mention BEFORE the fence is scanned")

::Method test_prose_around_fence_after
  -- Prose AFTER the last fence goes through the final "Do line Over source"
  -- copy loop: the other of the two copy points ScanProseMentions patches.
  result = FencedCode("test.md", .resources~ProseAroundFence)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('<code class="rexx rx-var">foo</code>') > 0, -
    "Prose around fence: mention AFTER the fence is scanned")

::Method test_prose_fence_itself_unaffected
  -- The fence's own tokens are highlighted by the normal Highlighter path,
  -- not by ScanProseMentions -- confirm the fence still highlights normally
  -- when prose mentions surround it (no interference between the two).
  result = FencedCode("test.md", .resources~ProseAroundFence)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~caselessPos('highlight-rexx-dark') > 0, -
    "Prose around fence: the fence itself still produces its own highlight div")

::Method test_prose_use_definition_match
  -- The PoC's own acceptance criterion (revision-codigo-en-prosa.md sec.
  -- 2.5): "Bark" mentioned in prose and "Bark" defined in a fenced block
  -- must carry the EXACT SAME class string, so they render in the same
  -- colour side by side.
  result = FencedCode("test.md", .resources~ProseUseDefinitionMatch)
  flat   = result~makeString('L', "0A"x)
  proseTag  = '<code class="rexx rx-const rx-method">Bark</code>'
  fenceTag  = '<span class="rx-const rx-method">Bark</span>'
  self~assertTrue(flat~pos(proseTag) > 0, -
    "Use/definition match: prose mention carries rx-const rx-method")
  self~assertTrue(flat~pos(fenceTag) > 0, -
    "Use/definition match: fenced definition carries the SAME class string")

::Method test_prose_doubled_backtick_with_inner_tick
  -- Mirrors Pandoc's own code-span rule: a doubled-backtick span whose
  -- content itself contains a single backtick is still a valid span, closed
  -- by the matching doubled run, and the mention machinery applies to it
  -- exactly as to a single-backtick span.
  result = FencedCode("test.md", .resources~ProseDoubledBacktick)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('<code class="rexx rx-var">a`b</code>') > 0, -
    "Doubled backtick: a``b``{.rexx-variable} keeps the inner backtick as content")

::Method test_prose_escaped_span_not_a_mention
  -- A doubled-backtick span used the OTHER way -- to quote a single-backtick
  -- span literally -- must NOT be read as a mention, matching Pandoc: the
  -- attribute after it is never consumed.
  result = FencedCode("test.md", .resources~ProseEscapedSpan)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('``Bark`{.rexx method}``') > 0, -
    "Escaped span: a doubled-backtick-quoted span is left completely verbatim")
  self~assertTrue(flat~caselessPos('highlight-rexx') == 0, -
    "Escaped span: no micro-container is produced for it")

::Method test_prose_typo_left_verbatim
  -- An unpublished public name (typo, or simply not yet in ProseTable) must
  -- be left EXACTLY as written -- backticks, dot and all -- not silently
  -- dropped or partially rewritten. This is the specific regression this
  -- test pins: an earlier version of the scanner lost the opening backtick
  -- and the "rexx-" prefix when reconstructing an unrecognised mention.
  result = FencedCode("test.md", .resources~ProseTypo)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('`x`{.rexx-clas}') > 0, -
    "Typo: an unpublished name is left byte-for-byte as written")
  self~assertTrue(flat~caselessPos('highlight-rexx') == 0, -
    "Typo: no micro-container is produced for an unpublished name")

::Method test_prose_unclosed_span_left_verbatim
  -- No closing backtick at all: not our business, must not be touched.
  result = FencedCode("test.md", .resources~ProseUnclosedSpan)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('`Bark{.rexx-method}') > 0, -
    "Unclosed span: a code span with no closing backtick is left untouched")

::Method test_prose_style_attr
  -- `` `x`{.rexx-variable style=light} `` -- per-mention style is an extra
  -- attribute (`style=name`), exactly as in a fence; it overrides the
  -- document default style for that one mention only. (There is no separate
  -- pin syntax: style= is the one and only form, shared with fences.)
  result = FencedCode("test.md", .resources~ProseStyleAttr)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('<span class="highlight-rexx-light"><code class="rexx rx-var">foo</code></span>') > 0, -
    "Style attr: style=light overrides the document default for this mention")

::Method test_prose_adjacent_mentions
  -- Two mentions back to back, no separating whitespace: neither consumes
  -- the other's backticks or attribute span.
  result = FencedCode("test.md", .resources~ProseAdjacentMentions)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('<code class="rexx rx-const rx-method">Bark</code>') > 0, -
    "Adjacent mentions: the first mention (rexx-method) resolves correctly")
  self~assertTrue(flat~pos('<code class="rexx rx-var">foo</code>') > 0, -
    "Adjacent mentions: the second mention (rexx-variable) resolves correctly")

::Method test_prose_plain_backtick_code_untouched
  -- Ordinary inline code with no attribute span at all must pass through
  -- completely unchanged -- this is the common case, and the fast path
  -- (a line with no backtick at all) is only half the guarantee.
  result = FencedCode("test.md", .resources~ProsePlainCode)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('`plain code`') > 0, -
    "Plain code: inline code with no {.rexx-*} attribute is left untouched")

::Method test_prose_no_backtick_untouched
  -- The fast path: a line with no backtick at all must come back identical.
  result = FencedCode("test.md", .resources~ProseNoBacktick)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos("Plain prose, nothing special here.") > 0, -
    "No backtick: a line with no backtick at all is returned unchanged")

/******************************************************************************/
/* Auto-parse mentions: `x`{.rexx} -- the fragment is PARSED, not tagged      */
/*                                                                            */
/* A `{.rexx}` mention hands its content to the same engine a fenced block    */
/* uses (via the HTML-INLINE driver), so a fragment that "holds" colours      */
/* token-by-token, identically to a listing of the same source; a fragment    */
/* that does not hold raises Syntax and is shown as an in-situ red shout.      */
/******************************************************************************/

::Method test_prose_autoparse_directive
  -- A complete directive holds: every token gets its real class, the same
  -- classes a fenced block would give the same source.
  result = FencedCode("test.md", .resources~ProseAutoDirective)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('<span class="rx-dkw">CLASS</span>') > 0, -
    "Auto-parse: ::CLASS directive keyword tokenises to rx-dkw")
  self~assertTrue(flat~pos('<span class="rx-dskw">SubClass</span>') > 0, -
    "Auto-parse: SubClass subkeyword tokenises to rx-dskw")

::Method test_prose_autoparse_wrapper
  -- The tokens sit inside the SAME chip a by-element mention uses, but the
  -- inner <code> carries only class "rexx" (the tokens carry their own).
  result = FencedCode("test.md", .resources~ProseAutoDirective)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('<span class="highlight-rexx-dark"><code class="rexx">') > 0, -
    "Auto-parse: wrapped in the highlight-rexx-<style> chip with a plain rexx <code>")

::Method test_prose_autoparse_clause
  -- A complete clause holds too: keywords, variable and operator all coloured.
  result = FencedCode("test.md", .resources~ProseAutoClause)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('<span class="rx-kw">If</span>') > 0, -
    "Auto-parse: If keyword in a complete clause tokenises to rx-kw")

::Method test_prose_autoparse_matches_fenced
  -- The whole point of reusing the engine: a fragment and a fenced block of
  -- the SAME source produce the SAME token spans, so they render identically.
  result = FencedCode("test.md", .resources~ProseAutoMatchesFenced)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('<span class="rx-dkw">CLASS</span>') > 0, -
    "Auto-parse matches fenced: the mention emits the same rx-dkw span...")
  -- ...and the fenced block below it emits that exact same span too.
  count = 0
  pos   = 1
  Loop Forever
    pos = flat~pos('<span class="rx-dkw">CLASS</span>', pos)
    If pos == 0 Then Leave
    count += 1
    pos += 1
  End
  self~assertEquals(2, count, -
    "Auto-parse matches fenced: mention and fenced block emit the identical span")

::Method test_prose_autoparse_broken_shouts
  -- Via A: a fragment that does not hold (an incomplete DO) raises Syntax and
  -- is rendered as a red in-situ shout carrying the offending fragment -- no
  -- line number, no reconstruction (the fragment IS its own context).
  result = FencedCode("test.md", .resources~ProseAutoBroken)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('rx-fragment-error') > 0, -
    "Via A: a fragment that does not hold gets the rx-fragment-error class")
  self~assertTrue(flat~pos('Do i = 1 To</code>') > 0, -
    "Via A: the offending fragment itself is shown inside the shout")

::Method test_prose_autoparse_broken_no_line_number
  -- The shout must NOT carry a line number or source reconstruction the way a
  -- fenced block's --continue trap does: the fragment is in the prose already.
  result = FencedCode("test.md", .resources~ProseAutoBroken)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~caselessPos('line') == 0 | flat~pos('Do i = 1 To</code>') > 0, -
    "Via A: no line-number ceremony -- just the fragment in a red chip")

::Method test_prose_autoparse_style_attr
  -- `{.rexx style=light}` -- the style= attribute applies to an auto-parse
  -- mention just as to a by-element one, overriding the document default.
  result = FencedCode("test.md", .resources~ProseAutoStyleAttr)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('<span class="highlight-rexx-light"><code class="rexx">') > 0, -
    "Auto-parse style attr: style=light overrides the document default for this chip")

::Method test_prose_byelement_still_distinct
  -- {.rexx-variable} (by-element) and {.rexx} (auto-parse) share the "{.rexx"
  -- opening but must NOT be confused: a by-element mention still tags one
  -- token and does NOT go through the parser.
  result = FencedCode("test.md", .resources~ProseByElementAndAuto)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('<code class="rexx rx-var">foo</code>') > 0, -
    "Coexistence: the by-element {.rexx-variable} still tags one token, unparsed")
  self~assertTrue(flat~pos('<span class="rx-kw">Say</span>') > 0, -
    "Coexistence: the {.rexx} alongside it is parsed into tokens")

/******************************************************************************/
/* The semantic keyword family: instruction / subkeyword / directive /        */
/* directive-subkeyword. Named by what the author asserts the word IS, not    */
/* by the syntactic role it would take in an unwritten context. Each maps to  */
/* a distinct element category (kw/skw/dkw/dskw), so a mentioned word shares   */
/* its colour with the same word tokenised inside a fence.                    */
/******************************************************************************/

::Method test_prose_instruction_mention
  -- The headline case: `Expose`{.rexx keyword} -> rx-kw, covering every
  -- keyword instruction with one diaphanous public name.
  result = FencedCode("test.md", .resources~ProseInstruction)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('<code class="rexx rx-kw">Expose</code>') > 0, -
    "Semantic: rexx-keyword resolves to rx-kw")

::Method test_prose_subkeyword_mention
  result = FencedCode("test.md", .resources~ProseSubkeyword)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('<code class="rexx rx-skw">Until</code>') > 0, -
    "Semantic: rexx-subkeyword resolves to rx-skw")

::Method test_prose_directive_subkeyword_mention
  result = FencedCode("test.md", .resources~ProseDirectiveSubkeyword)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('<code class="rexx rx-dskw">Subclass</code>') > 0, -
    "Semantic: rexx directive subkeyword resolves to rx-dskw")

::Method test_prose_same_word_different_category
  -- The point of semantic naming: the SAME word (Expose) is an instruction in
  -- one plane and a directive-subkeyword in the other. The author's chosen
  -- name decides which class it gets -- rx-kw here, rx-dskw there.
  result = FencedCode("test.md", .resources~ProseExposeBothWays)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('<code class="rexx rx-kw">Expose</code>') > 0, -
    "Semantic: Expose asserted as instruction -> rx-kw")
  self~assertTrue(flat~pos('<code class="rexx rx-dskw">Expose</code>') > 0, -
    "Semantic: the same Expose asserted as directive-subkeyword -> rx-dskw")

::Method test_prose_instruction_matches_fenced
  -- A mentioned instruction and a fenced-block keyword of the same word must
  -- carry the identical class string, so they render in the same colour.
  result = FencedCode("test.md", .resources~ProseInstructionMatchesFenced)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('<code class="rexx rx-kw">Say</code>') > 0, -
    "Semantic match: the mention carries rx-kw...")
  self~assertTrue(flat~pos('<span class="rx-kw">Say</span>') > 0, -
    "Semantic match: ...and the fenced block gives Say the SAME rx-kw")

/******************************************************************************/
/* The string-shaped call kludge (#3-calls). A taken constant written as a    */
/* STRING and used as a call/function name. A bare string in isolation is just */
/* a string, so we synthesise the call context (`NAME()` or `Call NAME`), let  */
/* the engine tokenise, trim the scaffolding, and relabel the base class to    */
/* what the author's tag asserts -- keeping the engine's structural subclasses */
/* (rx-oquo/rx-cquo/rx-ssuf). Only STRING-shaped content takes this path; a    */
/* bare name still goes through the generic by-element route.                  */
/******************************************************************************/

::Method test_prose_call_string_function_separates_quotes
  -- The whole reason the kludge exists: a string call name gets its opening and
  -- closing quotes their OWN spans (rx-oquo/rx-cquo), not one flat monochrome
  -- class over the entire "..." the generic by-element path would give.
  result = FencedCode("test.md", .resources~ProseCallStringFunction)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('<span class="rx-const rx-bif-func rx-oquo">"</span>') > 0, -
    "Call string function: the opening quote gets its own rx-oquo span")
  self~assertTrue(flat~pos('<span class="rx-const rx-bif-func rx-cquo">"</span>') > 0, -
    "Call string function: the closing quote gets its own rx-cquo span")
  self~assertTrue(flat~pos('<span class="rx-const rx-bif-func">44415445</span>') > 0, -
    "Call string function: the body carries the base class without a subclass")

::Method test_prose_call_string_function_no_paren_scaffold
  -- The synthesised `()` used to make the engine classify must NOT survive into
  -- the output: no rx-spe spans leak from the function-form scaffolding.
  result = FencedCode("test.md", .resources~ProseCallStringFunction)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('rx-spe') == 0, -
    "Call string function: the synthesised () scaffolding is trimmed away")

::Method test_prose_call_string_subroutine_no_call_scaffold
  -- Subroutine form synthesises `Call NAME`; the `Call` keyword span and the
  -- whitespace after it are scaffolding and must be trimmed, leaving only the
  -- constant's spans.
  result = FencedCode("test.md", .resources~ProseCallStringSubroutine)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('<span class="rx-const rx-bif-proc rx-oquo">"</span>') > 0, -
    "Call string subroutine: quote gets its own rx-oquo with the -proc base")
  self~assertTrue(flat~pos('<span class="rx-kw">Call</span>') == 0, -
    "Call string subroutine: the synthesised Call keyword is trimmed away")

::Method test_prose_call_string_matches_fenced
  -- The heart of the design: the kludge's core spans are BYTE-FOR-BYTE what a
  -- fenced `Call "44415445"X` emits, minus the Call+whitespace head. We assert
  -- the four constant spans appear from the mention AND again from the fence.
  result = FencedCode("test.md", .resources~ProseCallStringMatchesFenced)
  flat   = result~makeString('L', "0A"x)
  Do span Over .Array~of( -
      '<span class="rx-const rx-bif-proc rx-oquo">"</span>', -
      '<span class="rx-const rx-bif-proc">44415445</span>', -
      '<span class="rx-const rx-bif-proc rx-cquo">"</span>', -
      '<span class="rx-const rx-bif-proc rx-ssuf">X</span>' )
    count = 0
    pos   = 1
    Loop Forever
      pos = flat~pos(span, pos)
      If pos == 0 Then Leave
      count += 1
      pos += 1
    End
    self~assertEquals(2, count, -
      "Call string matches fenced: each constant span appears in both mention and fence")
  End

::Method test_prose_call_string_suffix_preserved
  -- A valid B/X suffix survives with its own rx-ssuf span (inherited free from
  -- the engine, since the synthesis parses the whole literal).
  result = FencedCode("test.md", .resources~ProseCallStringFunction)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('<span class="rx-const rx-bif-func rx-ssuf">X</span>') > 0, -
    "Call string suffix: a valid X suffix keeps its own rx-ssuf span")

::Method test_prose_call_tag_overrides_engine_guess
  -- Decision 2 (JMB): the BASE class is what the author's tag asserts, not what
  -- the engine deduces from the content. `"Date"` in mixed case would parse as
  -- EXTERNAL, but tagged builtin-function it must come out rx-bif-func.
  result = FencedCode("test.md", .resources~ProseCallTagOverrides)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('<span class="rx-const rx-bif-func">Date</span>') > 0, -
    "Call tag overrides: the author's builtin tag wins over the engine's external guess")
  self~assertTrue(flat~pos('rx-ext-func') == 0, -
    "Call tag overrides: no trace of the engine's deduced external class remains")

::Method test_prose_call_bad_suffix_shouts
  -- Decision 1 (JMB): an illegal suffix (S is not in the non-TUTOR {B,X} set) on
  -- something the author asserts is a call is OUR error to shout -- we refuse to
  -- synthesise and emit an honest error chip, never plausible-but-wrong HTML.
  result = FencedCode("test.md", .resources~ProseCallBadSuffix)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('rx-fragment-error') > 0, -
    "Call bad suffix: an illegal suffix produces an honest error chip")
  self~assertTrue(flat~caselessPos('suffix') > 0, -
    "Call bad suffix: the error message names the suffix as the problem")

::Method test_prose_suffix_tutor_accepted_when_unicode_on
  -- TUTOR/unicode widens the legal string-suffix set from {B,X} to {B,X,Y,P,G,T,U}
  -- (mirroring the engine's Scanner). With unicode enabled -- here via the document
  -- default options, exactly as the YAML prologue / CLI flag / fence would set it --
  -- a graphemes-suffixed constant `"..."G` must be ACCEPTED, keeping its rx-ssuf span.
  defaultOptions.         = 0
  defaultOptions.default  = "unicode"
  result = FencedCode("test.md", .resources~ProseConstTutorSuffix, "dark", defaultOptions.)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('rx-ssuf">G</span>') > 0, -
    "TUTOR suffix on: a G suffix is accepted and keeps its own rx-ssuf span")
  self~assertTrue(flat~caselessPos('invalid string suffix') == 0, -
    "TUTOR suffix on: no error chip is emitted for a legal TUTOR suffix")

::Method test_prose_suffix_tutor_rejected_when_unicode_off
  -- The SAME `"..."G` constant, but with unicode OFF (no dialect in the default
  -- options), must be REJECTED: G is a TUTOR-only suffix, so without TUTOR the
  -- engine would split the literal in two. Decision 1 (JMB): we shout, honestly.
  result = FencedCode("test.md", .resources~ProseConstTutorSuffix)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('rx-fragment-error') > 0, -
    "TUTOR suffix off: a G suffix without unicode produces an honest error chip")
  self~assertTrue(flat~caselessPos('suffix') > 0, -
    "TUTOR suffix off: the error message names the suffix as the problem")

::Method test_default_options_multiword_issue43
  -- GitHub issue #43 (JLF): md2html --default "executor style=vim-light-zellner"
  -- died with 88.900 "Invalid options 'r style=vim-light-zellner}'". The prose
  -- facade hands ParseOptions the BARE "{...}" (no language word) and an old
  -- ParseOptions stripped the word blindly (SubStr(options,9)), eating "{executo".
  -- Any non-empty default broke; the multi-word one is JLF's exact case.
  defaultOptions.         = 0
  defaultOptions.default  = "executor style=vim-light-zellner"
  result = FencedCode("test.md", .resources~DefaultOptionsIssue43, "dark", -
    defaultOptions.)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('highlight-rexx-vim-light-zellner') > 0, -
    "Issue 43: the block takes style= from the document default options")
  self~assertTrue(flat~pos('rx-fragment-error') == 0, -
    "Issue 43: the prose mention is processed without an error chip")
  -- A single-word default (no style=) must work too
  defaultOptions.default  = "executor"
  result = FencedCode("test.md", .resources~Basic, "dark", defaultOptions.)
  self~assertTrue(result~makeString('L', "0A"x)~pos('highlight-rexx-dark') > 0, -
    "Issue 43: a single-word default keeps the document style")

::Method test_prose_suffix_bx_valid_without_tutor
  -- Guard against over-gating: B and X are legal ALWAYS, TUTOR or not. With unicode
  -- off, an X-suffixed constant must still be accepted (no regression from the gate).
  result = FencedCode("test.md", .resources~ProseConstXSuffix)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~caselessPos('invalid string suffix') == 0, -
    "BX always valid: an X suffix is accepted even with unicode off")
  self~assertTrue(flat~pos('rx-ssuf">X</span>') > 0, -
    "BX always valid: the X suffix keeps its own rx-ssuf span")

::Method test_prose_span_extra_attr_executor_accepted
  -- Extra attributes on a code span, blank-separated after the class, exactly
  -- as a fence carries them after "rexx" (see the FencedCode doc). `{.rexx
  -- executor}` must enable Executor for THIS span, so Executor-only syntax
  -- (named arguments `name:value`) parses and highlights instead of shouting.
  result = FencedCode("test.md", .resources~ProseSpanExecutorAttr)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('rx-argument-name') > 0, -
    "Span extra-attr: {.rexx executor} enables Executor named args (rx-argument-name)")
  self~assertTrue(flat~pos('rx-fragment-error') == 0, -
    "Span extra-attr: {.rexx executor} parses cleanly, no error chip")

::Method test_prose_span_no_attr_shouts
  -- The SAME fragment WITHOUT the executor attribute must NOT parse: named
  -- arguments are Executor-only, so a bare {.rexx} auto-parse shouts.
  result = FencedCode("test.md", .resources~ProseSpanNoAttr)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('rx-fragment-error') > 0, -
    "Span extra-attr: bare {.rexx} on Executor-only syntax shouts (no attr)")

::Method test_prose_span_extra_attr_unicode_byelement
  -- Extra attrs work on the BY-ELEMENT family too, not just auto-parse:
  -- `{.rexx constant value unicode}` widens the suffix set so a TUTOR suffix
  -- (G) is accepted on a string-shaped taken constant.
  result = FencedCode("test.md", .resources~ProseSpanUnicodeAttr)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('rx-ssuf">G</span>') > 0, -
    "Span extra-attr: {.rexx constant value unicode} accepts the TUTOR G suffix")
  self~assertTrue(flat~caselessPos('invalid string suffix') == 0, -
    "Span extra-attr: unicode on the span, no suffix error")

::Method test_prose_span_extra_attr_no_leak
  -- CRITICAL: per-mention options must be an independent COPY. Two mentions on
  -- one line, the FIRST enabling executor and the SECOND bare: the second must
  -- NOT inherit executor (it would if the stem were shared, not copied). So the
  -- second, Executor-only, must shout. Guards against the ooRexx stem-sharing
  -- trap (`a. = b.` shares; needs ~copy).
  result = FencedCode("test.md", .resources~ProseSpanAttrLeak)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('rx-fragment-error') > 0, -
    "Span extra-attr: the attr does not leak to the next mention (second shouts)")
  self~assertTrue(flat~pos('rx-argument-name') > 0, -
    "Span extra-attr: the FIRST mention still parses with executor (leak test sanity)")

::Method test_prose_call_bare_shortcut_is_subroutine
  -- The bare shortcut (no -function/-subroutine) resolves to the subroutine
  -- subcategory, per the readme. `"DATE"`{.rexx builtin} -> rx-bif-proc.
  result = FencedCode("test.md", .resources~ProseCallBareShortcut)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('<span class="rx-const rx-bif-proc rx-oquo">"</span>') > 0, -
    "Call bare shortcut: {.rexx builtin} resolves to the subroutine class rx-bif-proc")

::Method test_prose_call_empty_string_is_valid
  -- An empty string is a perfectly valid call name in Rexx (`Call ("")` runs a
  -- routine labelled ""). It must tokenise as open-quote, empty body, close-quote
  -- -- three spans -- not be rejected.
  result = FencedCode("test.md", .resources~ProseCallEmptyString)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('<span class="rx-const rx-ext-proc rx-oquo">"</span>') > 0, -
    "Call empty string: the empty string opens with its own rx-oquo span")
  self~assertTrue(flat~pos('<span class="rx-const rx-ext-proc rx-cquo">"</span>') > 0, -
    "Call empty string: ...and closes with its own rx-cquo span")
  self~assertTrue(flat~pos('rx-fragment-error') == 0, -
    "Call empty string: it is NOT rejected -- an empty call name is valid Rexx")

::Method test_prose_call_bare_name_not_kludged
  -- Guard: the call tags ALSO mark bare names (`Length`{.rexx builtin function}),
  -- which the generic by-element path handles -- one element, one flat class is
  -- correct there. The kludge must NOT steal the bare case: it fires only on
  -- STRING-shaped content. A bare Length stays the flat monochrome mention.
  result = FencedCode("test.md", .resources~ProseBuiltinFunction)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('<code class="rexx rx-const rx-bif-func">Length</code>') > 0, -
    "Bare-name guard: a non-string builtin-function mention stays the flat generic chip")
  self~assertTrue(flat~pos('rx-oquo') == 0, -
    "Bare-name guard: no quote spans -- the kludge did not touch the bare name")

/******************************************************************************/
/* General taken constants in STRING form (this session's batch). Same beast   */
/* as the calls, different molds: directive names (method/class/routine/       */
/* requires) synthesise `::Keyword "X"`, label synthesises `Signal "X"`, and   */
/* environment `Address "X"`. Each string gets its quotes as their OWN spans    */
/* (rx-oquo/rx-cquo), and the base class is what the author's tag asserts.     */
/******************************************************************************/

::Method test_prose_method_string_separates_quotes
  result = FencedCode("test.md", .resources~ProseMethodString)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('<span class="rx-const rx-method rx-oquo">"</span>') > 0, -
    "Method string: the opening quote gets its own rx-oquo span")
  self~assertTrue(flat~pos('<span class="rx-const rx-method">Bark</span>') > 0, -
    "Method string: the body carries rx-method without a subclass")
  self~assertTrue(flat~pos('<span class="rx-const rx-method rx-cquo">"</span>') > 0, -
    "Method string: the closing quote gets its own rx-cquo span")

::Method test_prose_method_string_no_directive_scaffold
  -- The synthesised `::Method ` head (rx-dir + rx-dkw + rx-ws) must be trimmed:
  -- no directive-start or directive-keyword spans leak into the mention.
  result = FencedCode("test.md", .resources~ProseMethodString)
  flat   = result~makeString('L', "0A"x)
  self~assertTrue(flat~pos('rx-dir') == 0, -
    "Method string: the synthesised :: directive head is trimmed away")
  self~assertTrue(flat~pos('rx-dkw') == 0, -
    "Method string: the synthesised directive keyword is trimmed away")

