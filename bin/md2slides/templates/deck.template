<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>%title%</title>
<!-- IBM Plex (SIL OFL, open source): the family Rony's ODP decks are authored
     in. Loaded from Google Fonts so the deck-dominant font vote (font-prose /
     font-mono in the front matter) resolves to the real face. If the network is
     unavailable the CSS falls back to the generic sans-serif / monospace baked
     into --theme-font-prose / --theme-font-mono, so an offline deck still reads
     sanely -- it just loses the exact IBM Plex shapes. -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,400;0,600;1,400&family=IBM+Plex+Mono:wght@400;600&display=swap" rel="stylesheet">
<style>
%runtimeCSS%
</style>
<style>
%identityCSS%
%extraCSS%
</style>
<style>
%themesCSS%
</style>
</head>
<body>
<div id="stage"%stageAttrs%>
%stage%
  <div id="progress"></div>
  <div id="controls" class="controls-hidden">
  <label>section
    <select id="section-jump"><option value="">&mdash; jump &mdash;</option></select>
  </label>
  &nbsp;&middot;&nbsp;
  <label>code style
    <select id="rexx-style">
%rexxStyleOptions%
    </select>
  </label>
  &nbsp;&middot;&nbsp;
  <span class="controls-help" title="&#9664; &#9654; navigate  &middot;  F fullscreen  &middot;  F8 controls">&#9432;</span>
  </div>
</div>
<script>
%runtimeJS%
</script>
<script>
%chooserJS%
</script>
<script>
%jumpJS%
</script>
</body>
</html>
